# Copiar como .env.local y completar con los datos del proyecto Supabase de DESARROLLO.
# Dashboard de Supabase > Project Settings > API Keys.
# Solo se admiten la URL y la clave PUBLICABLE (sb_publishable_...).
# Nunca colocar aquí la clave secreta / service_role ni la contraseña de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-dev.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar_por_la_clave_publicable
